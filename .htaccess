# make3lab.com.br · public_html/.htaccess · 17/10/2026
# Vale só para o domínio principal. app.make3lab.com.br mora em public_html/app
# e fica de fora por causa da condição de host.

Options -Indexes
DirectoryIndex index.html index.php

RewriteEngine On

# https e sem www
RewriteCond %{HTTP_HOST} ^www\.make3lab\.com\.br$ [NC]
RewriteRule ^(.*)$ https://make3lab.com.br/$1 [R=301,L]
RewriteCond %{HTTP_HOST} ^make3lab\.com\.br$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://make3lab.com.br/$1 [R=301,L]

# enquanto o site completo não sobe, a raiz leva para a lista de espera (302, temporário)
RewriteCond %{HTTP_HOST} ^make3lab\.com\.br$ [NC]
RewriteRule ^$ /espera/ [R=302,L]

# make3lab.com.br/app leva para o sistema
RewriteCond %{HTTP_HOST} ^make3lab\.com\.br$ [NC]
RewriteRule ^app(/.*)?$ https://app.make3lab.com.br$1 [R=301,L]

# arquivos internos nunca saem
RewriteRule (^|/)(README|CHANGELOG)(\.md)?$ - [F,NC,L]
RewriteRule (^|/)\.(git|gitignore|env) - [F,NC,L]
RewriteRule (^|/)(tools|node_modules)(/|$) - [F,NC,L]
<FilesMatch "\.(md|mjs|py|json|lock|sql|ts)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
